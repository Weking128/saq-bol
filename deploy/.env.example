# Скопируйте в deploy/.env и заполните:  cp .env.example .env
# Пароли — только латинские буквы и цифры (они попадают в строку подключения).
# Сгенерировать надёжный пароль:  openssl rand -hex 24

# Домен сайта. DNS-запись A должна указывать на IP этого сервера.
SITE_DOMAIN=saq-bol.kz

# Пароль входа в /admin
ADMIN_PASSWORD=

# Пароль панели ДЭР /der — та же админка, но без итогового теста и сертификатов
# и только просмотр. Пусто — панель выключена.
DER_PASSWORD=

# Пароли базы: администратор (для бэкапов) и пользователь приложения
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=

# Необязательно:
# WEB_CONCURRENCY=4        # процессов Node (по умолчанию — число ядер, но не больше 4)
# MONGO_CACHE_GB=2         # память под кэш базы: ~1/4 RAM сервера (1 для 4 ГБ, 2 для 8 ГБ)
# BACKUP_KEEP_DAYS=14
# BACKUP_HOUR=3
# HTTP_PORT=80
# HTTPS_PORT=443
