# SITE_DOMAIN задаётся в deploy/.env, например quest.example.kz
# (для проверки на своём компьютере без домена — :80, тогда сайт работает по http)

# Сроки на приём запроса: медленные «висящие» соединения (атака slowloris) не займут сервер
{
	servers {
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 1MB
	}

	header {
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		# Браузер год открывает сайт только по HTTPS (по http заголовок не действует)
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# API — в приложение. Настоящий IP ученика передаётся в X-Real-IP (для лимитов регистраций);
	# присланный снаружи X-Forwarded-For Caddy не доверяет и заменяет.
	handle /api/* {
		reverse_proxy app:3000 {
			header_up X-Real-IP {remote_host}
			transport http {
				keepalive 30s
			}
		}
	}

	# Страницы, скрипты, картинки — напрямую с диска, без нагрузки на приложение.
	# Файлы уже сжаты при сборке образа (caddy.Dockerfile) — Caddy отдаёт готовые .br / .gz
	handle {
		root * /srv/public
		@admin path /admin /admin.html /der /der.html
		header @admin X-Robots-Tag "noindex, nofollow"
		header Cache-Control "no-cache"
		try_files {path} {path}.html
		file_server {
			precompressed br gzip
		}
	}
}
