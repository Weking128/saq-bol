# Скопируйте этот файл в .env и заполните (только для локального запуска).
# На Vercel эти же переменные задаются в Settings → Environment Variables.

# Строка подключения MongoDB Atlas (Database → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Имя базы данных (необязательно)
MONGODB_DB=saq-bol

# Пароль админ-панели — придумайте сложный
ADMIN_PASSWORD=

# Необязательно: если при локальном запуске ошибка querySrv EBADRESP
# DNS_SERVERS=8.8.8.8,1.1.1.1
